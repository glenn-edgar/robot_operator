# --- runtime / state (never commit) ---
**/var/
**/secrets/
*.db
*.db-journal
*.db-wal
*.bak
*.bak-*
fleet.env

# --- regenerated build artifacts ---
# chain IR is regenerated by build.sh from the chain DSL on every build
**/chains/connection.json
# native build trees (regenerated by ./build_libs.sh)
third_party/zenoh-pico/build/
third_party/zenoh_libs/c/*/build/
# NOTE: the staged .so ARE committed (vendored binaries) — see negation below.

# --- bulky analysis data dumps (regenerable; keep the .py, drop the dumps) ---
fleet_operations/irrigation_analytics/explore/snapshots/

# --- python / misc ---
__pycache__/
*.pyc
.venv/
venv/

# --- KEEP these despite the rules above ---
# Vendored transport .so — the whole point of build_assets/lib being committed.
!fleet_operations/packaging/build_assets/lib/
!fleet_operations/packaging/build_assets/lib/*.so
# The Claude Code operator skill travels with the repo.
!fleet_operations/irrigation_analytics/.claude/
!fleet_operations/irrigation_analytics/.claude/**
